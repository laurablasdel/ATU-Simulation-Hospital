/* Student charting draft autosave: preserves in-progress fields when moving between chart tabs. */
const ATU_DRAFT_KEY=STORAGE_KEY+"_student_drafts_v1";
function draftStore(){
 try{return JSON.parse(localStorage.getItem(ATU_DRAFT_KEY)||"{}")||{}}catch(e){return {}}
}
function draftId(view=currentView,patientId=activePatientId){
 return patientId&&view ? patientId+"::"+view : "";
}
function saveCurrentViewDraft(){
 if(isFaculty()||!activePatientId||!currentView)return;
 const root=document.getElementById("view");if(!root)return;
 const values={};let hasValue=false;
 root.querySelectorAll("input[id],textarea[id],select[id]").forEach(el=>{
  if(el.type==="file"||el.type==="button"||el.type==="submit")return;
  const value=(el.type==="checkbox"||el.type==="radio")?!!el.checked:el.value;
  values[el.id]=value;
  if((typeof value==="boolean"&&value)||String(value??"").trim())hasValue=true;
 });
 if(!Object.keys(values).length)return;
 const all=draftStore(),key=draftId();
 if(hasValue){
  all[key]={patientId:activePatientId,view:currentView,values,savedAt:new Date().toISOString()};
  localStorage.setItem(ATU_DRAFT_KEY,JSON.stringify(all));
  atuCloudBadge("Draft auto-saved");
 }else if(all[key]){
  delete all[key];localStorage.setItem(ATU_DRAFT_KEY,JSON.stringify(all));
 }
}
function restoreCurrentViewDraft(){
 if(isFaculty()||!activePatientId||!currentView)return;
 const d=draftStore()[draftId()];if(!d?.values)return;
 const root=document.getElementById("view");if(!root)return;
 Object.entries(d.values).forEach(([id,value])=>{
  const el=root.querySelector("#"+CSS.escape(id));if(!el||el.type==="file")return;
  if(el.type==="checkbox"||el.type==="radio")el.checked=!!value;else el.value=value??"";
 });
}
function clearCurrentViewDraft(){
 const key=draftId();if(!key)return;
 const all=draftStore();if(all[key]){delete all[key];localStorage.setItem(ATU_DRAFT_KEY,JSON.stringify(all));}
}
