const FILE_DB_NAME=STORAGE_KEY+":files";
const FILE_DB_STORE="files";
function openFileDb(){
 return new Promise((resolve,reject)=>{
  const req=indexedDB.open(FILE_DB_NAME,1);
  req.onupgradeneeded=()=>{const db=req.result;if(!db.objectStoreNames.contains(FILE_DB_STORE))db.createObjectStore(FILE_DB_STORE)};
  req.onsuccess=()=>resolve(req.result);req.onerror=()=>reject(req.error);
 });
}
async function storeDiagnosticFile(file){
 if(atuCloudReady&&atuSupabase){
  const safe=String(file.name||"diagnostic").replace(/[^a-zA-Z0-9._-]/g,"_");
  const path=`${Date.now()}-${Math.random().toString(36).slice(2,8)}-${safe}`;
  const {error}=await atuSupabase.storage.from("diagnostics").upload(path,file,{contentType:file.type,upsert:false});
  if(error)throw error;
  return "cloud:"+path;
 }
 const db=await openFileDb(),key=uid("diagfile");
 await new Promise((resolve,reject)=>{const tx=db.transaction(FILE_DB_STORE,"readwrite");tx.objectStore(FILE_DB_STORE).put(file,key);tx.oncomplete=resolve;tx.onerror=()=>reject(tx.error)});
 return "local:"+key;
}
async function getDiagnosticFile(key){
 if(String(key).startsWith("cloud:")){
  if(!atuSupabase)return null;
  const {data,error}=await atuSupabase.storage.from("diagnostics").download(String(key).slice(6));
  if(error){console.error(error);return null}
  return data;
 }
 const localKey=String(key).replace(/^local:/,""),db=await openFileDb();
 return await new Promise((resolve,reject)=>{const tx=db.transaction(FILE_DB_STORE,"readonly"),req=tx.objectStore(FILE_DB_STORE).get(localKey);req.onsuccess=()=>resolve(req.result||null);req.onerror=()=>reject(req.error)});
}
async function deleteDiagnosticFile(key){
 if(String(key).startsWith("cloud:")){
  if(atuSupabase)try{await atuSupabase.storage.from("diagnostics").remove([String(key).slice(6)])}catch(e){}
  return;
 }
 const localKey=String(key).replace(/^local:/,"");
 try{const db=await openFileDb();await new Promise((resolve,reject)=>{const tx=db.transaction(FILE_DB_STORE,"readwrite");tx.objectStore(FILE_DB_STORE).delete(localKey);tx.oncomplete=resolve;tx.onerror=()=>reject(tx.error)})}catch(e){}
}
