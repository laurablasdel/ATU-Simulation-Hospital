function releaseItem(id){
 const item=(state.releaseQueue||[]).find(x=>x.id===id);
 if(!item||item.status==="released")return;
 item.status="released";item.releasedAt=nowLocal();

 if(!item.chartRecordId&&item.kind==="order"){
   state.orders.push({
    id:uid("order"),patientId:item.patientId,time:item.releasedAt,
    provider:item.provider||activePatient()?.provider||"Provider",
    type:item.orderType||"Other",text:item.content,status:"Active",enteredBy:"Faculty Release"
   });
 }else if(!item.chartRecordId&&item.kind==="result"){
   if(Array.isArray(item.labRows)&&item.labRows.length){
    for(const row of item.labRows){
     if(!String(row.value||"").trim())continue;
     state.labs.push({id:uid("lab"),patientId:item.patientId,time:item.releasedAt,type:"Laboratory",test:row.test,result:row.value,reference:row.reference||"",flag:row.flag||"Normal",comments:`${item.title} • Released by faculty`});
    }
   }else{
