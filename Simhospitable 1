async function atuCloudReceive(payload){
 saveCurrentViewDraft();
 const row=payload.new||payload.old;
 if(!row||row.collection!==ATU_CLOUD_ROW_COLLECTION||row.item_id!==ATU_CLOUD_ROW_ID||row.updated_by===ATU_CLOUD_CLIENT)return;
 if(payload.eventType==="DELETE")return;
 atuCloudApplying=true;
 try{
  const tabMode=getTabMode();
  state=row.payload;
  state.settings ||= {mode:"faculty",facultyPin:"2026"};
  state.releaseQueue ||= [];state.messages ||= [];state.notifications ||= [];state.diagnosticFiles ||= [];state.labPanels ||= [];state.vitals ||= [];
  if(!state.settings.stephanieVitalsCleared20260916){state.vitals=state.vitals.filter(v=>v.patientId!=="stephanie-smith");state.settings.stephanieVitalsCleared20260916=true;atuStephanieVitalsMigrationDirty=true;}
  localStorage.setItem(STORAGE_KEY,JSON.stringify(state));
  setTabMode(tabMode);
 }finally{atuCloudApplying=false}
 atuCloudBadge("Cloud: LIVE ✓ • update received");
 window.refreshSimulationRecords?.();applyMode();if(window.simRefreshFromShared)window.simRefreshFromShared();else render();
 if(!isFaculty())setTimeout(showNextNotification,100);
}
async function atuCloudInit(){
 if(!ATU_SUPABASE_URL||!ATU_SUPABASE_KEY){atuCloudBadge("Local mode • this browser only");return;}
 try{
  if(!window.supabase?.createClient)throw new Error("Supabase library did not load");
  atuSupabase=window.supabase.createClient(ATU_SUPABASE_URL,ATU_SUPABASE_KEY,{realtime:{params:{eventsPerSecond:20}}});
  atuCloudBadge("Cloud: connecting…");
  atuCloudChannel=atuSupabase.channel("atu-simulation-hospital-live")
   .on("postgres_changes",{event:"*",schema:"public",table:"ehr_sync",filter:"collection=eq.app"},atuCloudReceive)
   .subscribe(status=>{
    if(status==="SUBSCRIBED")atuCloudBadge("Cloud: LIVE ✓");
    if(status==="CHANNEL_ERROR"||status==="TIMED_OUT")atuCloudBadge("Cloud: disconnected");
   });
  const found=await atuCloudPull();
  atuCloudReady=true;
  if(!found||atuStephanieVitalsMigrationDirty){await atuCloudPush();atuStephanieVitalsMigrationDirty=false;}
  atuCloudBadge("Cloud: LIVE ✓");
  window.refreshSimulationRecords?.();applyMode();if(window.simRefreshFromShared)window.simRefreshFromShared();else render();
  if(!isFaculty())setTimeout(showNextNotification,100);
 }catch(e){
  console.error("ATU cloud initialization failed",e);
  atuCloudReady=false;atuCloudBadge("Cloud offline • local backup");
 }
}

