function renderPEWS(){
 if(!requirePatient())return;
 const rows=(state.pewsAssessments||[]).filter(x=>x.patientId===activePatientId).slice().reverse();
 const behavior=[
  ["0","Playing / appropriate — active, alert, and interacting appropriately for age."],
  ["1","Sleeping — asleep but otherwise appropriate when aroused."],
  ["2","Irritable — difficult to console or noticeably more irritable than expected."],
  ["3","Lethargic, confused, or reduced response to pain — markedly decreased interaction or responsiveness."]
 ];
 const cardiovascular=[
  ["0","Pink color OR capillary refill 1–2 seconds."],
  ["1","Pale color OR capillary refill about 3 seconds."],
  ["2","Gray color OR capillary refill about 4 seconds OR heart rate 20 beats/min above the normal range for age."],
  ["3","Gray / mottled color OR capillary refill 5 seconds or longer OR heart rate 30 beats/min above the normal range for age OR bradycardia."]
 ];
 const respiratory=[
  ["0","Respiratory rate and effort within the expected range for age; no retractions."],
  ["1","Respiratory rate more than 10 breaths/min above the expected range for age OR accessory-muscle use OR approximately 30% oxygen requirement."],
  ["2","Respiratory rate more than 20 breaths/min above the expected range for age OR retractions OR approximately 40% oxygen requirement."],
  ["3","Respiratory rate 5 or more breaths/min below the expected range for age with retractions or grunting OR approximately 50% oxygen requirement."]
 ];
 const opts=(items,label)=>'<option value="">Select '+label+' score…</option>'+items.map(([score,desc])=>'<option value="'+score+'">'+score+' — '+esc(desc)+'</option>').join("");
 const guide=(title,items)=>'<div class="pewsGuide"><h3>'+title+'</h3>'+items.map(([score,desc])=>'<div class="pewsGuideRow"><b class="pewsScoreBox">'+score+'</b><span>'+esc(desc)+'</span></div>').join("")+'</div>';
 const riskInfo=(score)=>{
  if(score>=7)return {level:"RED",label:"High Risk — Immediate Action",cls:"pewsRed",care:["Call MET / Rapid Response per facility protocol.","Notify charge nurse, senior staff, and attending provider immediately.","Initiate emergency interventions per protocol.","Use continuous monitoring and increase frequency of vital signs and reassessment.","Prepare for a higher level of care if indicated; stay with the patient."]};
  if(score>=4)return {level:"YELLOW / AMBER",label:"Intermediate Risk",cls:"pewsYellow",care:["Notify charge nurse and responsible provider.","Increase frequency of vital signs and PEWS reassessment per facility policy.","Perform focused reassessment and provide indicated interventions.","Monitor closely for worsening findings and escalate if the score or condition deteriorates."]};
  return {level:"GREEN",label:"Low Risk / Stable",cls:"pewsGreen",care:["Continue routine care and monitoring.","Reassess PEWS and vital signs per facility policy.","Continue to observe for any change in condition and escalate for clinical concern regardless of score."]};
 };
 document.getElementById("view").innerHTML=
 panel("Pediatric Early Warning Score (PEWS)",`
  <div class="note" style="margin-bottom:10px">Select one score for each category. The total calculates automatically.</div>
  <div class="grid">
   <label>Student / RN Initials<input id="pewsStudent" placeholder="Initials or student name"></label>
   <label>Date / Time<input id="pewsTime" type="datetime-local"></label>
  </div>
  <div class="pewsGrid">
   <label><b>Behavior</b><select id="pewsBehavior">${opts(behavior,"Behavior")}</select></label>
   <label><b>Cardiovascular</b><select id="pewsCardio">${opts(cardiovascular,"Cardiovascular")}</select></label>
   <label><b>Respiratory</b><select id="pewsResp">${opts(respiratory,"Respiratory")}</select></label>
  </div>
  <div class="pewsTotal">PEWS TOTAL: <strong id="pewsTotal">—</strong> <span id="pewsMath" class="note"></span></div>
  <div id="pewsRisk" class="pewsRisk pewsNeutral"><div class="pewsRiskTitle">Complete all 3 categories to calculate risk level.</div></div>
  <div class="pewsTraffic">
   <div class="pewsTrafficCard pewsGreen"><b>GREEN (0–3)</b><span>Low Risk / Stable</span></div>
   <div class="pewsTrafficCard pewsYellow"><b>YELLOW / AMBER (4–6)</b><span>Intermediate Risk</span></div>
   <div class="pewsTrafficCard pewsRed"><b>RED (≥7)</b><span>High Risk / Immediate Action</span></div>
  </div>
  <div class="actions"><button id="savePEWS" class="primary">Save PEWS Score</button></div>
 `)+
 panel("PEWS Scoring Guide — Full Descriptions",`
  <div class="pewsGuideGrid">${guide("Behavior",behavior)}${guide("Cardiovascular",cardiovascular)}${guide("Respiratory",respiratory)}</div>
 `)+
 panel("Previous PEWS Scores",`
  <table><thead><tr><th>Date / Time</th><th>Student / RN</th><th>Behavior</th><th>Cardiovascular</th><th>Respiratory</th><th>Total</th></tr></thead>
  <tbody>${rows.map(x=>`<tr><td>${esc(x.time)}</td><td>${esc(x.student)}</td><td>${esc(x.behavior)}</td><td>${esc(x.cardiovascular)}</td><td>${esc(x.respiratory)}</td><td><b>${esc(x.total)}</b></td></tr>`).join("")||'<tr><td colspan="6">No PEWS scores documented yet.</td></tr>'}</tbody></table>
 `);
 const total=()=>{
  const vals=[pewsBehavior.value,pewsCardio.value,pewsResp.value];
  if(vals.some(v=>v==="")){
   pewsTotal.textContent="—";pewsMath.textContent="Complete all 3 categories";
   pewsRisk.className="pewsRisk pewsNeutral";
   pewsRisk.innerHTML='<div class="pewsRiskTitle">Complete all 3 categories to calculate risk level.</div>';
   return null;
  }
  const nums=vals.map(Number),sum=nums.reduce((a,b)=>a+b,0),risk=riskInfo(sum);
  pewsTotal.textContent=String(sum);pewsMath.textContent="("+nums[0]+" + "+nums[1]+" + "+nums[2]+")";
  pewsRisk.className="pewsRisk "+risk.cls;
  pewsRisk.innerHTML='<div class="pewsRiskTitle">'+esc(risk.level)+' — '+esc(risk.label)+'</div><div class="pewsCareTitle">Suggested Care / Escalation</div><ul>'+risk.care.map(x=>'<li>'+esc(x)+'</li>').join("")+'</ul>';
  return sum;
 };
 [pewsBehavior,pewsCardio,pewsResp].forEach(el=>el.onchange=total);
 pewsTime.value=new Date(Date.now()-new Date().getTimezoneOffset()*60000).toISOString().slice(0,16);
 savePEWS.onclick=()=>{
  const score=total();
  if(score===null){alert("Select a Behavior, Cardiovascular, and Respiratory score.");return}
  const student=pewsStudent.value.trim();
  if(!student){alert("Enter student name or RN initials.");return}
  state.pewsAssessments ||= [];
  const risk=riskInfo(score);
  state.pewsAssessments.push({id:uid("pews"),patientId:activePatientId,time:pewsTime.value||nowLocal(),student,behavior:Number(pewsBehavior.value),cardiovascular:Number(pewsCardio.value),respiratory:Number(pewsResp.value),total:score,riskLevel:risk.level,riskLabel:risk.label});
  audit("PEWS documented",activePatientId,`PEWS ${score} — Behavior ${pewsBehavior.value}, Cardiovascular ${pewsCardio.value}, Respiratory ${pewsResp.value}`);
  liveSave("pews_saved",{patientId:activePatientId,total:score});
  renderPEWS();
 };
}

