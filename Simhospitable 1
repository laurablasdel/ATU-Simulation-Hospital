     id:uid("lab"),patientId:item.patientId,time:item.releasedAt,type:item.resultType||"Laboratory",
     test:item.title,result:item.content,reference:item.reference||"",flag:item.flag||"Normal",comments:"Released by faculty"
    });
   }
   for(const fileId of (item.fileIds||[])){
    const f=(state.diagnosticFiles||[]).find(x=>x.id===fileId);
    if(f){f.status="released";f.releasedAt=item.releasedAt;}
   }
 }else if(!item.chartRecordId&&item.kind==="message"){
   state.messages ||= [];
