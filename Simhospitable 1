function reconcileSmithTylenolMAR(){
 const correct=row=>{
  if(!row)return;
  const name=row.name||row.medication||row.text||'';
  if(!/\b(?:Tylenol|acetaminophen)\b/i.test(name)||/oxycodone|hydrocodone|codeine|tramadol|butalbital|\//i.test(name))return;
  if(/^\s*325\s*mg\s*$/i.test(row.dose||''))row.dose='650 mg';
  for(const key of ['name','medication','text','title','content'])if(typeof row[key]==='string')row[key]=row[key].replace(/\b325\s*mg\b/gi,'650 mg');
  if(!row.dose&&/\b650\s*mg\b/i.test(row.name||''))row.dose='650 mg';
 };
 for(const med of state.medicationCatalog||[])if(med.patientId==='stephanie-smith')correct(med);
 for(const order of state.orders||[])if(order.patientId==='stephanie-smith')correct(order);
 for(const item of state.releaseQueue||[])if(item.patientId==='stephanie-smith'&&['medicationCatalog','orders'].includes(item.targetCollection))correct(item.rowData);
}
